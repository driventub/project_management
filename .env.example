POSTGRES_USER=projectmanagement
POSTGRES_PASSWORD=projectmanagement123
POSTGRES_DB=projectmanagement

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=projectmanagement;Username=projectmanagement;Password=projectmanagement123

# Used to hash seed-user passwords (PBKDF2 pepper). Seed users in
# backend/Infrastructure/Persistence/Seed/UsuarioSeed.cs were hashed with this
# exact value — changing it breaks the seeded login credentials.
SECURITY__PEPPER=CHANGE_ME_SUPER_SECRET_PEPPER_VALUE

# JWT issuance/validation. Key must be a long random string in real deployments.
JWT__KEY=CHANGE_ME_SUPER_SECRET_JWT_SIGNING_KEY_VALUE
JWT__ISSUER=ProjectManagement.Api
JWT__AUDIENCE=ProjectManagement.Client
JWT__EXPIRYMINUTES=60

# Origins allowed to call the api cross-origin (comma-separated). Dev Angular
# server and the docker-compose frontend dev container both serve on 4200.
CORS__ALLOWEDORIGINS=http://localhost:4200